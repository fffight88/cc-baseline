{
  "schema_version": 1,
  "feature": "judgment",
  "title": "Stakes mode (internal vs external) and deciding instead of asking",
  "plan": "work-judgment",
  "sources": [
    {
      "id": "REQ.judgment-plan",
      "kind": "requirement",
      "locator": "docs/plans/work-judgment.md (approved 2026-11-27)"
    },
    {
      "id": "REQ.stakes-mode",
      "kind": "requirement",
      "locator": "user request 2026-11-27: average work is fine for internal use, useless for money, portfolio, proof in front of others or marketing — split the two and act by situation"
    },
    {
      "id": "REQ.decide-not-ask",
      "kind": "requirement",
      "locator": "user request 2026-11-27: instead of asking the user to pick, resolve the reason for the question (research, analysis, genius thinking) and act; ask only for credentials and personal data, information only people have, and legal or ethical grey zones"
    }
  ],
  "actions": [
    {
      "id": "ACT.judgment.install",
      "title": "Install the rules and guides",
      "actor": "user",
      "trigger": "runs node bin/cli.js --yes",
      "preconditions": [
        "cc-baseline templates"
      ],
      "outputs": [
        "session rules 14 and 15",
        "reference_work_judgment.md",
        "updated protocols"
      ],
      "evidence_refs": [
        "REQ.judgment-plan"
      ]
    }
  ],
  "test_cases": [
    {
      "id": "TC.judgment.rules-present",
      "title": "The session rules carry the stakes mode and the ask boundary",
      "action_refs": [
        "ACT.judgment.install"
      ],
      "level": "functional",
      "surface": "cli",
      "preconditions": [
        "templates/memory/all_session_basic_rules.md"
      ],
      "steps": [
        {
          "goal": "Read the session rules file",
          "done_when": {
            "expect": "The file is read"
          }
        }
      ],
      "expected": [
        {
          "text": "The file has a heading that starts with '## 14.'",
          "observe": {
            "channel": "artifact",
            "key": "heading '## 14.'"
          }
        },
        {
          "text": "The file has a heading that starts with '## 15.'",
          "observe": {
            "channel": "artifact",
            "key": "heading '## 15.'"
          }
        },
        {
          "text": "Rule 14 names money, portfolio, public release or marketing as signs of external work",
          "observe": {
            "channel": "artifact",
            "key": "rule 14 text"
          }
        }
      ],
      "basis": {
        "kind": "requirement",
        "refs": [
          "REQ.stakes-mode",
          "REQ.decide-not-ask"
        ]
      },
      "readiness": "ready"
