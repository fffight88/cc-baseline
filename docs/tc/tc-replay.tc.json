{
  "schema_version": 1,
  "feature": "tc-replay",
  "title": "Replay rounds and dead-control sweep script",
  "plan": "tc-replay",
  "sources": [
    {
      "id": "REQ.tc-replay-plan",
      "kind": "requirement",
      "locator": "docs/plans/tc-replay.md (approved 2026-11-18)"
    },
    {
      "id": "DEC.replay-design",
      "kind": "decision",
      "locator": "user decision 2026-11-18: record-and-replay as data, reset_command, verify before accepting, sweep always by script, recordings under .cc-audits"
    }
  ],
  "actions": [
    {
      "id": "ACT.tc-replay.check",
      "title": "Check a recording",
      "actor": "e2e-tester",
      "trigger": "runs tc-replay.js check --run <tc-run.json> --tc <id>",
      "preconditions": [
        "a recording file exists"
      ],
      "outputs": [
        "exit code and one JSON line"
      ],
      "evidence_refs": [
        "REQ.tc-replay-plan"
      ]
    },
    {
      "id": "ACT.tc-replay.run",
      "title": "Replay TCs for a round",
      "actor": "e2e manager",
      "trigger": "runs tc-replay.js run --run <tc-run.json> --run-id <id> --tcs <ids>",
      "preconditions": [
        "accepted recordings",
        "the app is running at base_url"
      ],
      "outputs": [
        "one JSON line per TC",
        "tc-results.jsonl lines"
      ],
      "evidence_refs": [
        "REQ.tc-replay-plan",
        "DEC.replay-design"
      ]
    },
    {
      "id": "ACT.tc-replay.sweep",
      "title": "Sweep screens for dead controls",
      "actor": "e2e manager or e2e-tester",
      "trigger": "runs tc-sweep.js --run <tc-run.json> --run-id <id> --urls <paths>",
      "preconditions": [
        "the app is running at base_url"
      ],
      "outputs": [
        "sweep/<run_id>.json"
      ],
      "evidence_refs": [
        "REQ.tc-replay-plan",
        "DEC.replay-design"
      ]
    }
  ],
  "test_cases": [
