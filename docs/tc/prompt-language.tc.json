      "action_refs": [
        "ACT.prompt-language.hook"
      ],
      "level": "functional",
      "surface": "cli",
      "preconditions": [
        "stdin prompt is a long English log followed by the line '이거 왜 실패했어?'"
      ],
      "steps": [
        {
          "goal": "Run the hook command with that stdin",
          "done_when": {
            "expect": "The command exits"
          }
        }
      ],
      "expected": [
        {
          "text": "The additionalContext names Korean as the reply language",
          "observe": {
            "channel": "artifact",
