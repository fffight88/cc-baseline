        ]
      },
      "readiness": "ready"
    },
    {
      "id": "TC.prompt-language.bad-input",
      "title": "Unreadable input never blocks the prompt",
      "action_refs": [
        "ACT.prompt-language.hook"
      ],
      "level": "functional",
      "surface": "cli",
      "preconditions": [
        "stdin is the text 'not json'"
      ],
      "steps": [
        {
          "goal": "Run the hook command with that stdin",
          "done_when": {
            "expect": "The command exits"
          }
        }
      ],
      "expected": [
        {
          "text": "The exit code is 0",
          "observe": {
            "channel": "artifact",
            "key": "exit code"
          }
        },
        {
          "text": "The additionalContext says to reply in the language the user writes in",
          "observe": {
            "channel": "artifact",
            "key": "stdout JSON .hookSpecificOutput.additionalContext"
          }
        }
      ],
      "basis": {
        "kind": "requirement",
        "refs": [
          "REQ.prompt-language-plan"
        ]
      },
      "readiness": "ready"
    },
    {
      "id": "TC.prompt-language.install",
      "title": "Install registers the hook once",
      "action_refs": [
        "ACT.prompt-language.install"
      ],
      "level": "functional",
      "surface": "cli",
      "preconditions": [
        "a temporary HOME with an empty settings.json"
      ],
      "steps": [
        {
          "goal": "Run the installer twice into that HOME",
          "done_when": {
            "expect": "Both runs exit"
          }
        }
      ],
      "expected": [
        {
          "text": "settings.json has exactly one hook with _ccBaselineId user-prompt-submit-language",
          "observe": {
            "channel": "artifact",
            "key": "settings.json .hooks.UserPromptSubmit"
          }
        },
        {
          "text": "doctor reports every managed hook as registered",
          "observe": {
            "channel": "artifact",
            "key": "runChecks result for hooks"
          }
        }
      ],
      "basis": {
        "kind": "requirement",
        "refs": [
          "REQ.prompt-language-plan"
        ]
      },
      "readiness": "ready"
    },
    {
