{
  "schema_version": 1,
  "feature": "claims",
  "title": "Independent verification of large claim sets (claims.js, fact-auditor, Q.claim_supported)",
  "plan": "claim-verification",
  "sources": [
    {
      "id": "REQ.claims-plan",
      "kind": "requirement",
      "locator": "docs/plans/claim-verification.md (approved 2026-11-24)"
    },
    {
      "id": "REQ.claims-purpose",
      "kind": "requirement",
      "locator": "user request 2026-11-24: work across hundreds to thousands of screens cannot be checked by hand; a separate agent or script must verify it, not the producer"
    },
    {
      "id": "DEC.claims-scope",
      "kind": "decision",
      "locator": "user decision 2026-11-24: claims ledger, premise ledger, clean-room verifier, evidence grade, canaries, human audit of the auditor; Jev is used; pilot on the 11 accounting draft flows"
    },
    {
      "id": "DEC.claims-trigger",
      "kind": "decision",
      "locator": "user decision 2026-11-24: verify any report to the user whose facts need a reliability check (web research, analysis, comparison), not only bulk work; run with or without /plan; a skill may start it"
    }
  ],
  "actions": [
    {
      "id": "ACT.claims.lint",
      "title": "Check a claims run",
      "actor": "orchestrator",
      "trigger": "runs claims.js lint <run dir>",
      "preconditions": [
        "the run dir has claims.jsonl and premises.jsonl"
      ],
      "outputs": [
        "errors and warnings per claim id",
        "exit code"
      ],
      "evidence_refs": [
        "REQ.claims-plan"
      ]
    },
    {
      "id": "ACT.claims.prepare",
      "title": "Freeze the ledgers and mix in canaries",
      "actor": "orchestrator",
      "trigger": "runs claims.js prepare <run dir> --seed <n>",
      "preconditions": [
        "lint reports no error"
      ],
      "outputs": [
        "audit-input.jsonl",
        "freeze.json",
        "canary key outside the project"
      ],
      "evidence_refs": [
        "REQ.claims-plan",
        "DEC.claims-scope"
      ]
    },
    {
      "id": "ACT.claims.check-verifiers",
      "title": "Check that verifier scripts stay clean-room",
      "actor": "fact-auditor",
      "trigger": "runs claims.js check-verifiers <run dir>",
      "preconditions": [
        "verifier scripts exist under verifiers/"
      ],
      "outputs": [
        "forbidden references per file",
        "exit code"
      ],
      "evidence_refs": [
        "DEC.claims-scope"
      ]
    },
    {
      "id": "ACT.claims.screen-tc",
      "title": "Turn screen claims into a view-only TC file",
      "actor": "orchestrator",
      "trigger": "runs claims.js screen-tc <run dir>",
      "preconditions": [
        "audit-input.jsonl has screen items"
      ],
      "outputs": [
        "screen.tc.json"
      ],
      "evidence_refs": [
        "REQ.claims-plan"
      ]
    },
    {
      "id": "ACT.claims.import-results",
      "title": "Bring e2e results back as verdicts",
      "actor": "orchestrator",
      "trigger": "runs claims.js import-results <run dir> --results <tc-results.jsonl>",
      "preconditions": [
        "e2e-tester ran screen.tc.json"
      ],
      "outputs": [
        "verdict lines in verdicts.jsonl"
      ],
      "evidence_refs": [
        "REQ.claims-plan"
      ]
    },
    {
      "id": "ACT.claims.score",
      "title": "Score verdicts against the canary key and premises",
      "actor": "orchestrator",
      "trigger": "runs claims.js score <run dir>",
      "preconditions": [
        "every audit-input item has a verdict"
      ],
      "outputs": [
        "score.json",
        "code labels for Jev-judged canaries"
      ],
      "evidence_refs": [
        "DEC.claims-scope"
      ]
    },
    {
      "id": "ACT.claims.sample",
      "title": "Draw the human audit sample",
      "actor": "orchestrator",
      "trigger": "runs claims.js sample <run dir> --n <n> --seed <n>",
      "preconditions": [
        "score.json exists"
      ],
      "outputs": [
        "sample.json"
      ],
      "evidence_refs": [
        "DEC.claims-scope"
      ]
    },
    {
      "id": "ACT.claims.report",
      "title": "Write the verification report",
      "actor": "orchestrator",
      "trigger": "runs claims.js report <run dir>",
      "preconditions": [
        "score.json exists",
        "human.json exists or the sample was skipped"
      ],
      "outputs": [
        "report.md",
        "report.json"
      ],
      "evidence_refs": [
        "REQ.claims-purpose"
      ]
    },
    {
      "id": "ACT.claims.jev-claim",
      "title": "Ask Jev whether evidence supports a claim",
      "actor": "fact-auditor",
      "trigger": "runs tc-jev-judge.js claim <input.json>",
      "preconditions": [
        "a Jev key is configured"
      ],
      "outputs": [
        "Jev verdict line",
        "a sample in the Jev bank"
      ],
      "evidence_refs": [
        "DEC.claims-scope"
      ]
    },
    {
      "id": "ACT.claims.prepare-light",
      "title": "Prepare a small report in light mode",
      "actor": "orchestrator",
      "trigger": "runs claims.js prepare <run dir> on fewer than 30 claims",
      "preconditions": [
        "lint reports no error"
      ],
      "outputs": [
        "audit-input.jsonl with at least 2 canaries",
        "freeze.json with mode light"
      ],
      "evidence_refs": [
        "DEC.claims-trigger"
      ]
    }
  ],
  "test_cases": [
    {
      "id": "TC.claims.lint-missing-channel",
      "title": "A claim without a channel fails lint",
      "action_refs": [
        "ACT.claims.lint"
      ],
      "level": "functional",
      "surface": "cli",
      "preconditions": [
        "claims.jsonl has claim C-0002 with no channel field"
      ],
      "steps": [
        {
          "goal": "Run claims.js lint on the run dir",
          "done_when": {
            "expect": "The command exits"
          }
        }
      ],
      "expected": [
        {
          "text": "The exit code is 1",
          "observe": {
            "channel": "artifact",
            "key": "exit code"
          }
        },
        {
          "text": "The error output names C-0002",
          "observe": {
            "channel": "artifact",
            "key": "stderr"
          }
        }
      ],
      "basis": {
        "kind": "requirement",
        "refs": [
          "REQ.claims-plan"
        ]
      },
      "readiness": "ready"
    },
