      "level": "functional",
      "surface": "cli",
      "preconditions": [
        "templates/memory/all_session_basic_rules.md"
      ],
      "steps": [
        {
          "goal": "Read rule 12",
          "done_when": {
            "expect": "The rule is read"
          }
        }
      ],
      "expected": [
        {
          "text": "Rule 12 forbids writing a note that asks the user to run /verify-claims instead of running the check",
          "observe": {
            "channel": "artifact",
            "key": "rule 12 DON'T lines"
          }
        },
        {
          "text": "Rule 12 names a missing Agent tool or fact-auditor as the only reason to skip the check",
          "observe": {
            "channel": "artifact",
            "key": "rule 12 text"
          }
        }
      ],
